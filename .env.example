PORTKEY_API_KEY=your-key-here
# Leave DEMO_MODE empty: live when PORTKEY_API_KEY is set, free demo mode when it is not.
# Set DEMO_MODE=true to force demo mode even with a key.
DEMO_MODE=
# Priced in secondlook/budget.py: gpt-6-luna ($0.10/$0.50 per 1M), gpt-6-sol ($2/$10), gpt-6-astra ($10/$50).
# gpt-6-astra needs higher MAX_COST_PER_CALL_USD and SESSION_BUDGET_USD than the defaults below.
MODEL_FAST=gpt-6-luna
MODEL_SMART=gpt-6-luna
SESSION_BUDGET_USD=0.10
DAILY_BUDGET_USD=2.00
MAX_TOKENS_PER_CALL=1500
MAX_COST_PER_CALL_USD=0.05
PORTKEY_PROVIDER=openai
# low | medium | high; leave empty for models without reasoning
REASONING_EFFORT=low
